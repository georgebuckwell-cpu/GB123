{
  "$schema": "https://design-tokens.org/schema.json",
  "$meta": {
    "name": "Line Guide Design System",
    "version": "1.0.0",
    "description": "Production design tokens for Line Guide — the platform connecting machine manufacturers with food-manufacturing buyers. Brand personality: modern + technical. Dark-first.",
    "lastUpdated": "2026-06-16",
    "format": "W3C Design Tokens Community Group draft"
  },

  "color": {
    "$description": "All color values are sRGB hex. Palettes ship light + dark resolved values under `semantic`.",

    "primary": {
      "$description": "Signal Green — the Line Guide brand accent. Use 500 as the hero brand color, 400 as the bright accent on dark surfaces, 600/700 for text on light surfaces.",
      "50":  { "$value": "#E6FBEF", "$type": "color" },
      "100": { "$value": "#BFF4D6", "$type": "color" },
      "200": { "$value": "#84E9AF", "$type": "color" },
      "300": { "$value": "#45DA86", "$type": "color" },
      "400": { "$value": "#14C765", "$type": "color" },
      "500": { "$value": "#00B259", "$type": "color" },
      "600": { "$value": "#009149", "$type": "color" },
      "700": { "$value": "#00713A", "$type": "color" },
      "800": { "$value": "#00532B", "$type": "color" },
      "900": { "$value": "#00371D", "$type": "color" }
    },

    "secondary": {
      "$description": "Ion Blue — cool technical complement for links, data viz, and secondary actions. Pairs with green without competing.",
      "50":  { "$value": "#EAF1FF", "$type": "color" },
      "100": { "$value": "#CBDDFF", "$type": "color" },
      "200": { "$value": "#9DBEFF", "$type": "color" },
      "300": { "$value": "#6A99FF", "$type": "color" },
      "400": { "$value": "#3D74F5", "$type": "color" },
      "500": { "$value": "#2459DB", "$type": "color" },
      "600": { "$value": "#1B45B0", "$type": "color" },
      "700": { "$value": "#143488", "$type": "color" },
      "800": { "$value": "#0E2563", "$type": "color" },
      "900": { "$value": "#0A1A47", "$type": "color" }
    },

    "neutral": {
      "$description": "Carbon — a subtly cool/green-tinted neutral ramp for text, surfaces and borders. 0 = pure white, 950 = near-black page background.",
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#F6F8F7", "$type": "color" },
      "100": { "$value": "#ECEFEE", "$type": "color" },
      "200": { "$value": "#D9DFDD", "$type": "color" },
      "300": { "$value": "#BCC6C3", "$type": "color" },
      "400": { "$value": "#95A29F", "$type": "color" },
      "500": { "$value": "#6E7B78", "$type": "color" },
      "600": { "$value": "#515D5A", "$type": "color" },
      "700": { "$value": "#3A4543", "$type": "color" },
      "800": { "$value": "#25302E", "$type": "color" },
      "900": { "$value": "#161E1D", "$type": "color" },
      "950": { "$value": "#0B100F", "$type": "color" }
    },

    "dark": {
      "$description": "Green-tinted near-black surface ramp for the dark-first UI. Mirrors the brand's immersive technical mood.",
      "bg":      { "$value": "#070D0B", "$type": "color" },
      "surface": { "$value": "#0C1412", "$type": "color" },
      "raised":  { "$value": "#101A18", "$type": "color" },
      "overlay": { "$value": "#16211F", "$type": "color" },
      "hover":   { "$value": "#1C2926", "$type": "color" }
    },

    "semantic": {
      "$description": "Functional colors. Each role carries surface (bg), border, solid (fill), and text variants for light and dark.",
      "success": {
        "light": { "solid": { "$value": "#16A34A", "$type": "color" }, "bg": { "$value": "#E7F8EE", "$type": "color" }, "border": { "$value": "#A7E8C0", "$type": "color" }, "text": { "$value": "#0A6E32", "$type": "color" } },
        "dark":  { "solid": { "$value": "#22C55E", "$type": "color" }, "bg": { "$value": "#0E1F16", "$type": "color" }, "border": { "$value": "#1F4B33", "$type": "color" }, "text": { "$value": "#4ADE80", "$type": "color" } }
      },
      "warning": {
        "light": { "solid": { "$value": "#D97706", "$type": "color" }, "bg": { "$value": "#FEF3E2", "$type": "color" }, "border": { "$value": "#FAD9A0", "$type": "color" }, "text": { "$value": "#92500A", "$type": "color" } },
        "dark":  { "solid": { "$value": "#FBBF24", "$type": "color" }, "bg": { "$value": "#241B08", "$type": "color" }, "border": { "$value": "#4D3A10", "$type": "color" }, "text": { "$value": "#FCD34D", "$type": "color" } }
      },
      "error": {
        "light": { "solid": { "$value": "#DC2626", "$type": "color" }, "bg": { "$value": "#FDEAEA", "$type": "color" }, "border": { "$value": "#F5B5B5", "$type": "color" }, "text": { "$value": "#A31616", "$type": "color" } },
        "dark":  { "solid": { "$value": "#F87171", "$type": "color" }, "bg": { "$value": "#241011", "$type": "color" }, "border": { "$value": "#502526", "$type": "color" }, "text": { "$value": "#FCA5A5", "$type": "color" } }
      },
      "info": {
        "light": { "solid": { "$value": "#2459DB", "$type": "color" }, "bg": { "$value": "#EAF1FF", "$type": "color" }, "border": { "$value": "#B6CDFF", "$type": "color" }, "text": { "$value": "#16409B", "$type": "color" } },
        "dark":  { "solid": { "$value": "#4F8BFF", "$type": "color" }, "bg": { "$value": "#0C1830", "$type": "color" }, "border": { "$value": "#1E3A6B", "$type": "color" }, "text": { "$value": "#85AEFF", "$type": "color" } }
      }
    },

    "tier": {
      "$description": "Subscription tier accents. Used on pricing cards, manufacturer badges, and match ribbons.",
      "basic":   { "solid": { "$value": "#6E7B78", "$type": "color" }, "soft": { "$value": "#1C2926", "$type": "color" }, "text": { "$value": "#BCC6C3", "$type": "color" } },
      "premium": { "solid": { "$value": "#00C961", "$type": "color" }, "soft": { "$value": "#0E1F16", "$type": "color" }, "text": { "$value": "#45DA86", "$type": "color" }, "gradient": { "$value": "linear-gradient(135deg, #14C765 0%, #00B259 100%)", "$type": "gradient" } },
      "ultra":   { "solid": { "$value": "#7B6CF6", "$type": "color" }, "soft": { "$value": "#160F30", "$type": "color" }, "text": { "$value": "#B4A7FF", "$type": "color" }, "gradient": { "$value": "linear-gradient(135deg, #00E0A4 0%, #6B8BFF 55%, #9A6BFF 100%)", "$type": "gradient" } }
    },

    "brand": {
      "$description": "Composite brand utilities.",
      "hero":      { "$value": "#00C961", "$type": "color" },
      "accent":    { "$value": "#14C765", "$type": "color" },
      "gradient":  { "$value": "linear-gradient(135deg, #14C765 0%, #00B259 100%)", "$type": "gradient" },
      "glow":      { "$value": "rgba(20,199,101,0.22)", "$type": "color" },
      "selection": { "$value": "rgba(20,199,101,0.30)", "$type": "color" }
    }
  },

  "typography": {
    "$description": "Font families, fluid 9-step scale, weights, line-heights, and letter-spacing.",
    "fontFamily": {
      "display": { "$value": "'Space Grotesk', 'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Headings & display. Geometric, engineered character." },
      "body":    { "$value": "'Inter', system-ui, -apple-system, sans-serif", "$type": "fontFamily", "$description": "UI & body. Neutral, highly legible at small sizes." },
      "mono":    { "$value": "'JetBrains Mono', 'SFMono-Regular', ui-monospace, monospace", "$type": "fontFamily", "$description": "Technical data: part numbers, specs, ratings, code." }
    },
    "fontWeight": {
      "light":     { "$value": "300", "$type": "fontWeight" },
      "regular":   { "$value": "400", "$type": "fontWeight" },
      "medium":    { "$value": "500", "$type": "fontWeight" },
      "semibold":  { "$value": "600", "$type": "fontWeight" },
      "bold":      { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight" }
    },
    "scale": {
      "$description": "9-step scale, ~1.25 (major third) ratio with a fluid clamp() for each step. min = mobile, max = desktop.",
      "xs":   { "size": { "$value": "0.75rem",  "$type": "dimension" }, "fluid": { "$value": "clamp(0.75rem, 0.74rem + 0.05vw, 0.78rem)", "$type": "dimension" }, "lineHeight": { "$value": "1.5",  "$type": "number" }, "letterSpacing": { "$value": "0.02em",  "$type": "dimension" } },
      "sm":   { "size": { "$value": "0.875rem", "$type": "dimension" }, "fluid": { "$value": "clamp(0.875rem, 0.86rem + 0.07vw, 0.92rem)", "$type": "dimension" }, "lineHeight": { "$value": "1.55", "$type": "number" }, "letterSpacing": { "$value": "0.01em",  "$type": "dimension" } },
      "base": { "size": { "$value": "1rem",     "$type": "dimension" }, "fluid": { "$value": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)",   "$type": "dimension" }, "lineHeight": { "$value": "1.6",  "$type": "number" }, "letterSpacing": { "$value": "0em",     "$type": "dimension" } },
      "lg":   { "size": { "$value": "1.125rem", "$type": "dimension" }, "fluid": { "$value": "clamp(1.125rem, 1.09rem + 0.18vw, 1.25rem)", "$type": "dimension" }, "lineHeight": { "$value": "1.6",  "$type": "number" }, "letterSpacing": { "$value": "0em",     "$type": "dimension" } },
      "xl":   { "size": { "$value": "1.25rem",  "$type": "dimension" }, "fluid": { "$value": "clamp(1.25rem, 1.19rem + 0.3vw, 1.5rem)",    "$type": "dimension" }, "lineHeight": { "$value": "1.4",  "$type": "number" }, "letterSpacing": { "$value": "-0.005em", "$type": "dimension" } },
      "2xl":  { "size": { "$value": "1.5rem",   "$type": "dimension" }, "fluid": { "$value": "clamp(1.5rem, 1.39rem + 0.55vw, 2rem)",      "$type": "dimension" }, "lineHeight": { "$value": "1.3",  "$type": "number" }, "letterSpacing": { "$value": "-0.01em",  "$type": "dimension" } },
      "3xl":  { "size": { "$value": "2rem",     "$type": "dimension" }, "fluid": { "$value": "clamp(2rem, 1.78rem + 1.1vw, 2.75rem)",     "$type": "dimension" }, "lineHeight": { "$value": "1.2",  "$type": "number" }, "letterSpacing": { "$value": "-0.015em", "$type": "dimension" } },
      "4xl":  { "size": { "$value": "2.75rem",  "$type": "dimension" }, "fluid": { "$value": "clamp(2.75rem, 2.3rem + 2.25vw, 3.75rem)",  "$type": "dimension" }, "lineHeight": { "$value": "1.1",  "$type": "number" }, "letterSpacing": { "$value": "-0.02em",  "$type": "dimension" } },
      "5xl":  { "size": { "$value": "3.75rem",  "$type": "dimension" }, "fluid": { "$value": "clamp(3.75rem, 2.9rem + 4.25vw, 5rem)",     "$type": "dimension" }, "lineHeight": { "$value": "1.05", "$type": "number" }, "letterSpacing": { "$value": "-0.025em", "$type": "dimension" } }
    }
  },

  "spacing": {
    "$description": "8px grid foundation. `1` = 4px half-step; all subsequent steps are multiples of 8 unless noted.",
    "0":   { "$value": "0",     "$type": "dimension" },
    "px":  { "$value": "1px",   "$type": "dimension" },
    "0.5": { "$value": "0.125rem", "$type": "dimension" },
    "1":   { "$value": "0.25rem",  "$type": "dimension" },
    "2":   { "$value": "0.5rem",   "$type": "dimension" },
    "3":   { "$value": "0.75rem",  "$type": "dimension" },
    "4":   { "$value": "1rem",     "$type": "dimension" },
    "5":   { "$value": "1.25rem",  "$type": "dimension" },
    "6":   { "$value": "1.5rem",   "$type": "dimension" },
    "8":   { "$value": "2rem",     "$type": "dimension" },
    "10":  { "$value": "2.5rem",   "$type": "dimension" },
    "12":  { "$value": "3rem",     "$type": "dimension" },
    "16":  { "$value": "4rem",     "$type": "dimension" },
    "20":  { "$value": "5rem",     "$type": "dimension" },
    "24":  { "$value": "6rem",     "$type": "dimension" },
    "32":  { "$value": "8rem",     "$type": "dimension" },
    "40":  { "$value": "10rem",    "$type": "dimension" },
    "48":  { "$value": "12rem",    "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",       "$type": "dimension" },
    "sm":   { "$value": "0.375rem","$type": "dimension" },
    "md":   { "$value": "0.625rem","$type": "dimension" },
    "lg":   { "$value": "1rem",    "$type": "dimension" },
    "xl":   { "$value": "1.375rem","$type": "dimension" },
    "2xl":  { "$value": "1.75rem", "$type": "dimension" },
    "full": { "$value": "9999px",  "$type": "dimension" }
  },

  "border": {
    "hairline": { "$value": "1px",   "$type": "dimension" },
    "thin":     { "$value": "1.5px", "$type": "dimension" },
    "thick":    { "$value": "2px",   "$type": "dimension" }
  },

  "shadow": {
    "$description": "Elevation set. Dark-mode shadows lean on deeper blacks; brand glow used for focus/emphasis.",
    "xs":   { "$value": "0 1px 2px rgba(0,0,0,0.25)", "$type": "shadow" },
    "sm":   { "$value": "0 2px 6px rgba(0,0,0,0.30), 0 1px 2px rgba(0,0,0,0.20)", "$type": "shadow" },
    "md":   { "$value": "0 4px 20px rgba(0,0,0,0.45), 0 1px 4px rgba(0,0,0,0.30)", "$type": "shadow" },
    "lg":   { "$value": "0 12px 48px rgba(0,0,0,0.55), 0 4px 12px rgba(0,0,0,0.30)", "$type": "shadow" },
    "xl":   { "$value": "0 24px 80px rgba(0,0,0,0.60), 0 8px 24px rgba(0,0,0,0.35)", "$type": "shadow" },
    "glow": { "$value": "0 0 0 1px rgba(20,199,101,0.40), 0 0 48px rgba(20,199,101,0.22)", "$type": "shadow" },
    "focus":{ "$value": "0 0 0 2px #070D0B, 0 0 0 4px #14C765", "$type": "shadow" }
  },

  "motion": {
    "$description": "Transition durations, easing curves, and micro-interaction philosophy.",
    "duration": {
      "instant":    { "$value": "100ms", "$type": "duration" },
      "fast":       { "$value": "150ms", "$type": "duration" },
      "base":       { "$value": "200ms", "$type": "duration" },
      "moderate":   { "$value": "300ms", "$type": "duration" },
      "slow":       { "$value": "500ms", "$type": "duration" },
      "deliberate": { "$value": "800ms", "$type": "duration" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)",     "$type": "cubicBezier", "$description": "Default for most UI transitions." },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)",       "$type": "cubicBezier", "$description": "Elements entering the screen." },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)",     "$type": "cubicBezier", "$description": "Elements leaving the screen." },
      "emphasized": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",   "$type": "cubicBezier", "$description": "Hero/expressive moments." },
      "spring":     { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "$description": "Playful overshoot for toggles, chips, success." }
    }
  },

  "breakpoint": {
    "xs":  { "$value": "0px",    "$type": "dimension", "$description": "Mobile portrait base." },
    "sm":  { "$value": "480px",  "$type": "dimension", "$description": "Large phones." },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Tablets." },
    "lg":  { "$value": "1024px", "$type": "dimension", "$description": "Laptops / small desktop." },
    "xl":  { "$value": "1280px", "$type": "dimension", "$description": "Desktop." },
    "2xl": { "$value": "1536px", "$type": "dimension", "$description": "Large desktop." }
  },

  "container": {
    "sm":   { "$value": "640px",  "$type": "dimension" },
    "md":   { "$value": "768px",  "$type": "dimension" },
    "lg":   { "$value": "1024px", "$type": "dimension" },
    "xl":   { "$value": "1200px", "$type": "dimension" },
    "full": { "$value": "1440px", "$type": "dimension" }
  },

  "zIndex": {
    "base":     { "$value": "0",    "$type": "number" },
    "raised":   { "$value": "10",   "$type": "number" },
    "sticky":   { "$value": "100",  "$type": "number" },
    "nav":      { "$value": "200",  "$type": "number" },
    "dropdown": { "$value": "300",  "$type": "number" },
    "overlay":  { "$value": "400",  "$type": "number" },
    "modal":    { "$value": "500",  "$type": "number" },
    "toast":    { "$value": "600",  "$type": "number" },
    "tooltip":  { "$value": "700",  "$type": "number" }
  }
}
